rules_version = '2';

// Cola isto nas Regras do Firestore (Consola Firebase → Firestore → Regras) e publica.
// Ajusta se já tiveres regras prórias — o importante é não bloquear `status_changes`.

service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{docId} {
      allow read, write: if request.auth != null;
    }

    match /themes/{docId} {
      allow read, write: if request.auth != null;
    }

    match /developments/{docId} {
      allow read, write: if request.auth != null;
    }

    match /status_changes/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
