rules_version = '2';

// Cola isto nas Regras do Firestore (Consola Firebase → Firestore → Regras) e publica.
// v1.2.10: bootstrap admin + leitura app_users sem admin enquanto !hasAdmin.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function appUserPath() {
      return /databases/$(database)/documents/app_users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(appUserPath())
        && get(appUserPath()).data.role == 'admin'
        && get(appUserPath()).data.blocked != true
        && get(appUserPath()).data.deleted != true;
    }

    function isActiveUser() {
      return signedIn() && (
        !exists(appUserPath())
        || (
          get(appUserPath()).data.blocked != true
          && get(appUserPath()).data.deleted != true
        )
      );
    }

    function accessConfigPath() {
      return /databases/$(database)/documents/app_config/access;
    }

    function bootstrapAdminAllowed() {
      return !exists(accessConfigPath())
        || get(accessConfigPath()).data.hasAdmin != true;
    }

    match /app_config/access {
      // Leitura pública: só indica se o registo livre deve fechar (hasAdmin).
      allow read: if true;
      allow create, update: if signedIn() && (
        isAdmin()
        || (
          request.resource.data.hasAdmin == true
          && bootstrapAdminAllowed()
        )
      );
    }

    match /app_users/{userId} {
      // Durante o bootstrap (ainda sem admin) qualquer sessão autenticada pode ler,
      // para o cliente antigo que consulta se já existe admin não falhar.
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || bootstrapAdminAllowed()
      );

      allow create: if signedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.keys().hasAll(['email', 'role', 'blocked', 'deleted'])
          && request.resource.data.blocked == false
          && request.resource.data.deleted == false
          && (
            request.resource.data.role == 'user'
            || (request.resource.data.role == 'admin' && bootstrapAdminAllowed())
          )
        )
        || isAdmin()
      );

      // Admin gere tudo; o próprio pode atualizar nome/email;
      // ou reivindicar o 1.º admin enquanto bootstrapAdminAllowed().
      allow update: if isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.blocked == resource.data.blocked
          && request.resource.data.deleted == resource.data.deleted
        )
        || (
          request.auth.uid == userId
          && request.resource.data.role == 'admin'
          && resource.data.role != 'admin'
          && bootstrapAdminAllowed()
        );

      allow delete: if isAdmin();
    }

    match /projects/{docId} {
      allow read, write: if isActiveUser();
    }

    match /project_types/{docId} {
      allow read, write: if isActiveUser();
    }

    match /project_areas/{docId} {
      allow read, write: if isActiveUser();
    }

    match /project_subtypes/{docId} {
      allow read, write: if isActiveUser();
    }

    match /themes/{docId} {
      allow read, write: if isActiveUser();
    }

    match /developments/{docId} {
      allow read, write: if isActiveUser();
    }

    match /projects/{projectId}/notes/{noteId} {
      allow read, write: if isActiveUser();
    }

    match /themes/{themeId}/notes/{noteId} {
      allow read, write: if isActiveUser();
    }

    match /developments/{devId}/notes/{noteId} {
      allow read, write: if isActiveUser();
    }

    match /status_changes/{docId} {
      allow read, write: if isActiveUser();
    }

    match /user_settings/{userId} {
      allow read, write: if isActiveUser() && request.auth.uid == userId;
    }

    match /user_work_clock/{userId} {
      allow read, write: if isActiveUser() && request.auth.uid == userId;
    }

    match /user_project_work/{docId} {
      allow read: if isActiveUser() &&
        (!resource.exists || resource.data.userId == request.auth.uid);
      allow create, update: if isActiveUser() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isActiveUser() &&
        resource.exists && resource.data.userId == request.auth.uid;
    }

    match /user_ide_session_logs/{docId} {
      allow read: if isActiveUser() &&
        (!resource.exists || resource.data.userId == request.auth.uid);
      allow create: if isActiveUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'userId', 'workspaceRoot', 'workspaceName', 'tgProjectId', 'editor',
          'openedAt', 'closedAt', 'durationSeconds'
        ]) &&
        request.resource.data.workspaceRoot is string &&
        request.resource.data.workspaceName is string &&
        request.resource.data.tgProjectId is string &&
        request.resource.data.editor is string &&
        request.resource.data.durationSeconds is int &&
        request.resource.data.openedAt is timestamp &&
        request.resource.data.closedAt is timestamp;
      allow update: if isActiveUser() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.workspaceRoot == resource.data.workspaceRoot &&
        request.resource.data.workspaceName == resource.data.workspaceName &&
        request.resource.data.editor == resource.data.editor &&
        request.resource.data.openedAt is timestamp &&
        request.resource.data.closedAt is timestamp &&
        request.resource.data.durationSeconds is int &&
        request.resource.data.durationSeconds >= 0 &&
        (
          request.resource.data.tgProjectId == resource.data.tgProjectId ||
          (
            resource.data.tgProjectId == '' &&
            request.resource.data.tgProjectId is string &&
            request.resource.data.tgProjectId.size() > 0
          )
        );
      allow delete: if isActiveUser() &&
        resource.data.userId == request.auth.uid &&
        resource.data.source == 'manual';
    }

    match /user_ide_schedule/{userId}/cards/{cardId} {
      allow read, write: if isActiveUser() && request.auth.uid == userId;
    }

    match /user_ide_project_reports/{userId}/by_project/{projectId} {
      allow read: if isActiveUser() && request.auth.uid == userId;
      allow create, update: if isActiveUser() &&
        request.auth.uid == userId &&
        request.resource.data.userId == userId &&
        request.resource.data.projectId == projectId;
      allow delete: if isActiveUser() &&
        request.auth.uid == userId &&
        resource.data.userId == userId;
    }
  }
}
