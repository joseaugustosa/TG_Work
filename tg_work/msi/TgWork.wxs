<?define var.ReleaseRoot = "..\build\windows\x64\runner\Release" ?>
<!-- Instalação em C:\Program Files\TgWork. Confirma o UAC (executar com permissões de administrador). -->
<!-- Version é atualizada por build_msi.ps1 a partir do pubspec.yaml -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="TgWork"
      Version="1.2.14.0"
      Language="1033"
      Manufacturer="TgWork"
      Scope="perMachine"
      UpgradeCode="2E8A7B4C-5D1F-4A9B-8E0C-3F6D2A1B4E50"
      ProductCode="*">
    <MajorUpgrade
        DowngradeErrorMessage="Já tem uma versão mais recente de [ProductName] instalada." />
    <Property Id="ARPNOREPAIR" Value="1" />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="TgWork" Level="1">
      <ComponentGroupRef Id="TgWorkApp" />
      <ComponentGroupRef Id="TgWorkDesktop" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory
          Name="TgWork"
          Id="INSTALLFOLDER"
          FileSource="$(var.ReleaseRoot)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Package>

  <Fragment>
    <ComponentGroup Id="TgWorkApp" Directory="INSTALLFOLDER">
      <Files Include="$(var.ReleaseRoot)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="TgWorkDesktop" Directory="DesktopFolder">
      <Component
          Id="TgWorkAtalhoDesktopCmp"
          Guid="E7C1B4A0-3D2F-4B8A-9E0C-5F1D2A3B4C5D">
        <RegistryValue
            Root="HKCU"
            Key="Software\TgWork\Shortcuts"
            Name="Desktop"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <Shortcut
            Id="TgWorkAtalhoDesktop"
            Name="TgWork"
            Description="TgWork"
            Target="[INSTALLFOLDER]tg_work.exe"
            WorkingDirectory="INSTALLFOLDER" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
